# Copy to .env and fill in for your environment.
# Local dev works with zero changes (defaults to a local SQLite file).

ENV=development
DEBUG=true

# Local default: sqlite:///./ticket_booking.db
# Neon/Postgres example:
# DATABASE_URL=postgresql+psycopg2://user:password@ep-example-123456.us-east-2.aws.neon.tech/ticket_booking_db?sslmode=require
DATABASE_URL=sqlite:///./ticket_booking.db

JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=

DATA_DIR=../data/processed
